{
  "name": "plain-a11y",
  "version": "0.1.0",
  "description": "Scan any webpage for accessibility problems and get a plain-language report instead of a wall of jargon.",
  "type": "module",
  "bin": {
    "plain-a11y": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/__tests__/*.test.js"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "cli",
    "axe-core"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.3"
  }
}
